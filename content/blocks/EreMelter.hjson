name: Slag Extractor
description: Extract lava from a steam vent.  Needs heat to maintain the slag temperature.
type: AttributeCrafter
size: 3
drawer: { 
	type: DrawMulti,
	drawers: [
		{ type: DrawRegion, 
		  suffix: "-bottom"
		},
		{ type: DrawBlurSpin,
		  suffix: "-rotator",	
		  rotateSpeed: 6
		},
		{ type: DrawRegion,
		  suffix: "-mid"		
		},
		{
		  type: DrawLiquidTile,
		  drawLiquid: slag,
		  padding: 9.5		  
		},
		{
			type: DrawDefault
		}
	]
}
baseEfficiency: 0
minEfficiency: 9
displayEfficiency: false
attribute: steam
hasPower: false
heatRequirement: 4
requirements: [
  tungsten/20
  beryllium/20
  graphite/15
]
outputLiquids: [slag/3]
category: production
research: vent-condenser
